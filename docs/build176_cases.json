 "bookmarks": {
  "_": "{local, server, now (ISO), expect}: per id wint de nieuwste at, bij gelijke at wint removed; verwijderingen ouder dan 90 dagen weg; max 200 aanwezig (nieuwste at); uitvoer: aanwezig op at aflopend, dan verwijderingen op at aflopend, bij gelijke at op id. Vergelijk alleen id, removed (false als het ontbreekt) en at (als tijd).",
  "cases": [
   {
    "name": "samenvoegen",
    "now": "2026-11-15T12:00:00Z",
    "local": [
     {
      "id": "abc|x1@60",
      "key": "x1",
      "playlistID": "ABC",
      "title": "Film",
      "t": 60,
      "at": "2026-11-15T10:00:00Z"
     }
    ],
    "server": [
     {
      "id": "abc|x2@120",
      "key": "x2",
      "playlistID": "abc",
      "title": "Film 2",
      "t": 120,
      "at": "2026-11-15T11:00:00Z"
     }
    ],
    "expect": [
     {
      "id": "abc|x2@120",
      "at": "2026-11-15T11:00:00Z"
     },
     {
      "id": "abc|x1@60",
      "at": "2026-11-15T10:00:00Z"
     }
    ]
   },
   {
    "name": "verwijdering wint als nieuwer",
    "now": "2026-11-15T12:00:00Z",
    "local": [
     {
      "id": "abc|x1@60",
      "key": "x1",
      "playlistID": "abc",
      "title": "Film",
      "t": 60,
      "at": "2026-11-15T10:00:00Z"
     }
    ],
    "server": [
     {
      "id": "abc|x1@60",
      "removed": true,
      "at": "2026-11-15T11:00:00Z"
     }
    ],
    "expect": [
     {
      "id": "abc|x1@60",
      "removed": true,
      "at": "2026-11-15T11:00:00Z"
     }
    ]
   },
   {
    "name": "opnieuw bewaard na verwijderen",
    "now": "2026-11-15T12:00:00Z",
    "local": [
     {
      "id": "abc|x1@60",
      "key": "x1",
      "playlistID": "abc",
      "title": "Film",
      "t": 60,
      "at": "2026-11-15T11:30:00Z"
     }
    ],
    "server": [
     {
      "id": "abc|x1@60",
      "removed": true,
      "at": "2026-11-15T11:00:00Z"
     }
    ],
    "expect": [
     {
      "id": "abc|x1@60",
      "at": "2026-11-15T11:30:00Z"
     }
    ]
   },
   {
    "name": "gelijke tijd: removed wint",
    "now": "2026-11-15T12:00:00Z",
    "local": [
     {
      "id": "abc|x1@60",
      "key": "x1",
      "playlistID": "abc",
      "title": "Film",
      "t": 60,
      "at": "2026-11-15T11:00:00Z"
     }
    ],
    "server": [
     {
      "id": "abc|x1@60",
      "removed": true,
      "at": "2026-11-15T11:00:00Z"
     }
    ],
    "expect": [
     {
      "id": "abc|x1@60",
      "removed": true,
      "at": "2026-11-15T11:00:00Z"
     }
    ]
   },
   {
    "name": "oude verwijdering opgeruimd",
    "now": "2026-11-15T12:00:00Z",
    "local": [],
    "server": [
     {
      "id": "abc|x9@5",
      "removed": true,
      "at": "2026-08-01T00:00:00Z"
     },
     {
      "id": "abc|x8@5",
      "removed": true,
      "at": "2026-09-01T00:00:00Z"
     }
    ],
    "expect": [
     {
      "id": "abc|x8@5",
      "removed": true,
      "at": "2026-09-01T00:00:00Z"
     }
    ]
   },
   {
    "name": "gelijke at: op id",
    "now": "2026-11-15T12:00:00Z",
    "local": [
     {
      "id": "abc|b@1",
      "key": "b",
      "playlistID": "abc",
      "title": "B",
      "t": 1,
      "at": "2026-11-15T10:00:00Z"
     }
    ],
    "server": [
     {
      "id": "abc|a@1",
      "key": "a",
      "playlistID": "abc",
      "title": "A",
      "t": 1,
      "at": "2026-11-15T10:00:00Z"
     }
    ],
    "expect": [
     {
      "id": "abc|a@1",
      "at": "2026-11-15T10:00:00Z"
     },
     {
      "id": "abc|b@1",
      "at": "2026-11-15T10:00:00Z"
     }
    ]
   }
  ],
  "limit": {
   "_": "205 aanwezige momenten met at = 2026-11-01T00:00:00Z + i minuten (i = 0..204, id abc|k<i>@1) → 200 over, de oudste vijf (k0..k4) vallen weg",
   "count": 205,
   "keep": 200
  }
 },
