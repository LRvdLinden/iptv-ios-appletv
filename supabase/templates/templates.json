{
 "mailer_subjects_confirmation": "Welkom bij Bingr · Bevestig je e-mailadres / Confirm your email",
 "mailer_templates_confirmation_content": "<!doctype html>\n<html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><meta name=\"supported-color-schemes\" content=\"dark\"><title>Bingr</title></head>\n<body style=\"margin:0;padding:0;background:#000000\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#000000\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:520px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\">\n<tr><td style=\"padding:0 4px 24px\">\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n    <td style=\"vertical-align:middle\"><img src=\"https://bingr.online/apple-touch-icon.png\" width=\"44\" height=\"44\" alt=\"\" style=\"display:block;border-radius:10px\"></td>\n    <td style=\"vertical-align:middle;padding-left:12px\"><div style=\"font-size:30px;font-weight:900;letter-spacing:1px;color:#ffffff;line-height:30px\">BINGR</div><div style=\"height:4px;width:74px;background:#E50914;border-radius:2px;margin-top:6px\"></div></td>\n  </tr></table>\n</td></tr>\n<tr><td style=\"background:#141414;border-radius:12px;padding:36px 32px;border-top:4px solid #E50914\">\n{{ if and .Data.lang (eq .Data.lang \"nl\") }}<h1 style=\"margin:0 0 16px;font-size:26px;line-height:32px;font-weight:800;color:#ffffff\">Bevestig je e-mailadres</h1><p style=\"margin:0 0 28px;font-size:16px;line-height:24px;color:#d6d6d6\">Fijn dat je er bent! Bevestig je e-mailadres en log daarna in de Bingr-app in om te beginnen met kijken.</p><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#E50914;color:#ffffff;text-decoration:none;font-weight:700;font-size:16px;padding:14px 32px;border-radius:6px\">E-mailadres bevestigen</a><p style=\"margin:28px 0 0;font-size:14px;line-height:21px;color:#b3b3b3\">De link is 24 uur geldig.</p><p style=\"margin:28px 0 0;font-size:12px;line-height:18px;color:#8c8c8c\">Werkt de knop niet? Kopieer deze link:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#b3b3b3;word-break:break-all\">{{ .ConfirmationURL }}</a></p>{{ else }}<h1 style=\"margin:0 0 16px;font-size:26px;line-height:32px;font-weight:800;color:#ffffff\">Confirm your email address</h1><p style=\"margin:0 0 28px;font-size:16px;line-height:24px;color:#d6d6d6\">Welcome to Bingr! Confirm your email address, then sign in to the Bingr app to start watching.</p><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#E50914;color:#ffffff;text-decoration:none;font-weight:700;font-size:16px;padding:14px 32px;border-radius:6px\">Confirm email address</a><p style=\"margin:28px 0 0;font-size:14px;line-height:21px;color:#b3b3b3\">This link is valid for 24 hours.</p><p style=\"margin:28px 0 0;font-size:12px;line-height:18px;color:#8c8c8c\">Button not working? Copy this link:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#b3b3b3;word-break:break-all\">{{ .ConfirmationURL }}</a></p>{{ end }}\n</td></tr>\n<tr><td style=\"padding:24px 8px 0;font-size:12px;line-height:18px;color:#737373;text-align:center\">\n{{ if and .Data.lang (eq .Data.lang \"nl\") }}Je ontvangt deze e-mail omdat iemand dit adres ({{ .Email }}) bij Bingr heeft gebruikt. Was jij dit niet? Dan kun je deze e-mail negeren.{{ else }}You received this email because this address ({{ .Email }}) was used with Bingr. If this wasn't you, you can ignore this email.{{ end }}<br><br>\n<a href=\"https://bingr.online\" style=\"color:#b3b3b3;text-decoration:none;font-weight:700\">bingr.online</a> &nbsp;·&nbsp; <a href=\"https://support.bingr.online/\" style=\"color:#737373\">Support</a> &nbsp;·&nbsp; <a href=\"https://bingr.online/privacy.html\" style=\"color:#737373\">Privacy</a>\n</td></tr>\n</table></td></tr></table></body></html>",
 "mailer_subjects_recovery": "Bingr · Nieuw wachtwoord instellen / Reset your password",
 "mailer_templates_recovery_content": "<!doctype html>\n<html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><meta name=\"supported-color-schemes\" content=\"dark\"><title>Bingr</title></head>\n<body style=\"margin:0;padding:0;background:#000000\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#000000\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:520px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\">\n<tr><td style=\"padding:0 4px 24px\">\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n    <td style=\"vertical-align:middle\"><img src=\"https://bingr.online/apple-touch-icon.png\" width=\"44\" height=\"44\" alt=\"\" style=\"display:block;border-radius:10px\"></td>\n    <td style=\"vertical-align:middle;padding-left:12px\"><div style=\"font-size:30px;font-weight:900;letter-spacing:1px;color:#ffffff;line-height:30px\">BINGR</div><div style=\"height:4px;width:74px;background:#E50914;border-radius:2px;margin-top:6px\"></div></td>\n  </tr></table>\n</td></tr>\n<tr><td style=\"background:#141414;border-radius:12px;padding:36px 32px;border-top:4px solid #E50914\">\n{{ if and .Data.lang (eq .Data.lang \"nl\") }}<h1 style=\"margin:0 0 16px;font-size:26px;line-height:32px;font-weight:800;color:#ffffff\">Nieuw wachtwoord instellen</h1><p style=\"margin:0 0 28px;font-size:16px;line-height:24px;color:#d6d6d6\">We kregen een verzoek om het wachtwoord van je Bingr-account te wijzigen. Klik op de knop om een nieuw wachtwoord te kiezen.</p><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#E50914;color:#ffffff;text-decoration:none;font-weight:700;font-size:16px;padding:14px 32px;border-radius:6px\">Nieuw wachtwoord kiezen</a><p style=\"margin:28px 0 0;font-size:14px;line-height:21px;color:#b3b3b3\">Heb je dit niet aangevraagd? Dan hoef je niets te doen; je wachtwoord blijft hetzelfde.</p><p style=\"margin:28px 0 0;font-size:12px;line-height:18px;color:#8c8c8c\">Werkt de knop niet? Kopieer deze link:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#b3b3b3;word-break:break-all\">{{ .ConfirmationURL }}</a></p>{{ else }}<h1 style=\"margin:0 0 16px;font-size:26px;line-height:32px;font-weight:800;color:#ffffff\">Reset your password</h1><p style=\"margin:0 0 28px;font-size:16px;line-height:24px;color:#d6d6d6\">We received a request to reset the password for your Bingr account. Click the button to choose a new password.</p><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#E50914;color:#ffffff;text-decoration:none;font-weight:700;font-size:16px;padding:14px 32px;border-radius:6px\">Choose a new password</a><p style=\"margin:28px 0 0;font-size:14px;line-height:21px;color:#b3b3b3\">Didn't ask for this? You don't need to do anything; your password stays the same.</p><p style=\"margin:28px 0 0;font-size:12px;line-height:18px;color:#8c8c8c\">Button not working? Copy this link:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#b3b3b3;word-break:break-all\">{{ .ConfirmationURL }}</a></p>{{ end }}\n</td></tr>\n<tr><td style=\"padding:24px 8px 0;font-size:12px;line-height:18px;color:#737373;text-align:center\">\n{{ if and .Data.lang (eq .Data.lang \"nl\") }}Je ontvangt deze e-mail omdat iemand dit adres ({{ .Email }}) bij Bingr heeft gebruikt. Was jij dit niet? Dan kun je deze e-mail negeren.{{ else }}You received this email because this address ({{ .Email }}) was used with Bingr. If this wasn't you, you can ignore this email.{{ end }}<br><br>\n<a href=\"https://bingr.online\" style=\"color:#b3b3b3;text-decoration:none;font-weight:700\">bingr.online</a> &nbsp;·&nbsp; <a href=\"https://support.bingr.online/\" style=\"color:#737373\">Support</a> &nbsp;·&nbsp; <a href=\"https://bingr.online/privacy.html\" style=\"color:#737373\">Privacy</a>\n</td></tr>\n</table></td></tr></table></body></html>",
 "mailer_subjects_invite": "Je bent uitgenodigd voor Bingr / You're invited to Bingr",
 "mailer_templates_invite_content": "<!doctype html>\n<html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><meta name=\"supported-color-schemes\" content=\"dark\"><title>Bingr</title></head>\n<body style=\"margin:0;padding:0;background:#000000\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#000000\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:520px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\">\n<tr><td style=\"padding:0 4px 24px\">\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n    <td style=\"vertical-align:middle\"><img src=\"https://bingr.online/apple-touch-icon.png\" width=\"44\" height=\"44\" alt=\"\" style=\"display:block;border-radius:10px\"></td>\n    <td style=\"vertical-align:middle;padding-left:12px\"><div style=\"font-size:30px;font-weight:900;letter-spacing:1px;color:#ffffff;line-height:30px\">BINGR</div><div style=\"height:4px;width:74px;background:#E50914;border-radius:2px;margin-top:6px\"></div></td>\n  </tr></table>\n</td></tr>\n<tr><td style=\"background:#141414;border-radius:12px;padding:36px 32px;border-top:4px solid #E50914\">\n{{ if and .Data.lang (eq .Data.lang \"nl\") }}<h1 style=\"margin:0 0 16px;font-size:26px;line-height:32px;font-weight:800;color:#ffffff\">Je bent uitgenodigd</h1><p style=\"margin:0 0 28px;font-size:16px;line-height:24px;color:#d6d6d6\">Je bent uitgenodigd om een Bingr-account te maken. Klik op de knop om je account te activeren en een wachtwoord te kiezen.</p><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#E50914;color:#ffffff;text-decoration:none;font-weight:700;font-size:16px;padding:14px 32px;border-radius:6px\">Uitnodiging accepteren</a><p style=\"margin:28px 0 0;font-size:14px;line-height:21px;color:#b3b3b3\">De uitnodiging is 24 uur geldig.</p><p style=\"margin:28px 0 0;font-size:12px;line-height:18px;color:#8c8c8c\">Werkt de knop niet? Kopieer deze link:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#b3b3b3;word-break:break-all\">{{ .ConfirmationURL }}</a></p>{{ else }}<h1 style=\"margin:0 0 16px;font-size:26px;line-height:32px;font-weight:800;color:#ffffff\">You're invited</h1><p style=\"margin:0 0 28px;font-size:16px;line-height:24px;color:#d6d6d6\">You've been invited to create a Bingr account. Click the button to activate your account and choose a password.</p><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#E50914;color:#ffffff;text-decoration:none;font-weight:700;font-size:16px;padding:14px 32px;border-radius:6px\">Accept invitation</a><p style=\"margin:28px 0 0;font-size:14px;line-height:21px;color:#b3b3b3\">This invitation is valid for 24 hours.</p><p style=\"margin:28px 0 0;font-size:12px;line-height:18px;color:#8c8c8c\">Button not working? Copy this link:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#b3b3b3;word-break:break-all\">{{ .ConfirmationURL }}</a></p>{{ end }}\n</td></tr>\n<tr><td style=\"padding:24px 8px 0;font-size:12px;line-height:18px;color:#737373;text-align:center\">\n{{ if and .Data.lang (eq .Data.lang \"nl\") }}Je ontvangt deze e-mail omdat iemand dit adres ({{ .Email }}) bij Bingr heeft gebruikt. Was jij dit niet? Dan kun je deze e-mail negeren.{{ else }}You received this email because this address ({{ .Email }}) was used with Bingr. If this wasn't you, you can ignore this email.{{ end }}<br><br>\n<a href=\"https://bingr.online\" style=\"color:#b3b3b3;text-decoration:none;font-weight:700\">bingr.online</a> &nbsp;·&nbsp; <a href=\"https://support.bingr.online/\" style=\"color:#737373\">Support</a> &nbsp;·&nbsp; <a href=\"https://bingr.online/privacy.html\" style=\"color:#737373\">Privacy</a>\n</td></tr>\n</table></td></tr></table></body></html>",
 "mailer_subjects_magic_link": "Inloggen bij Bingr / Sign in to Bingr",
 "mailer_templates_magic_link_content": "<!doctype html>\n<html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><meta name=\"supported-color-schemes\" content=\"dark\"><title>Bingr</title></head>\n<body style=\"margin:0;padding:0;background:#000000\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#000000\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:520px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\">\n<tr><td style=\"padding:0 4px 24px\">\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n    <td style=\"vertical-align:middle\"><img src=\"https://bingr.online/apple-touch-icon.png\" width=\"44\" height=\"44\" alt=\"\" style=\"display:block;border-radius:10px\"></td>\n    <td style=\"vertical-align:middle;padding-left:12px\"><div style=\"font-size:30px;font-weight:900;letter-spacing:1px;color:#ffffff;line-height:30px\">BINGR</div><div style=\"height:4px;width:74px;background:#E50914;border-radius:2px;margin-top:6px\"></div></td>\n  </tr></table>\n</td></tr>\n<tr><td style=\"background:#141414;border-radius:12px;padding:36px 32px;border-top:4px solid #E50914\">\n{{ if and .Data.lang (eq .Data.lang \"nl\") }}<h1 style=\"margin:0 0 16px;font-size:26px;line-height:32px;font-weight:800;color:#ffffff\">Inloggen bij Bingr</h1><p style=\"margin:0 0 28px;font-size:16px;line-height:24px;color:#d6d6d6\">Klik op de knop om in te loggen bij Bingr.</p><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#E50914;color:#ffffff;text-decoration:none;font-weight:700;font-size:16px;padding:14px 32px;border-radius:6px\">Inloggen</a><p style=\"margin:28px 0 0;font-size:14px;line-height:21px;color:#b3b3b3\">Deze link werkt één keer en is kort geldig.</p><p style=\"margin:28px 0 0;font-size:12px;line-height:18px;color:#8c8c8c\">Werkt de knop niet? Kopieer deze link:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#b3b3b3;word-break:break-all\">{{ .ConfirmationURL }}</a></p>{{ else }}<h1 style=\"margin:0 0 16px;font-size:26px;line-height:32px;font-weight:800;color:#ffffff\">Sign in to Bingr</h1><p style=\"margin:0 0 28px;font-size:16px;line-height:24px;color:#d6d6d6\">Click the button to sign in to Bingr.</p><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#E50914;color:#ffffff;text-decoration:none;font-weight:700;font-size:16px;padding:14px 32px;border-radius:6px\">Sign in</a><p style=\"margin:28px 0 0;font-size:14px;line-height:21px;color:#b3b3b3\">This link works once and expires soon.</p><p style=\"margin:28px 0 0;font-size:12px;line-height:18px;color:#8c8c8c\">Button not working? Copy this link:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#b3b3b3;word-break:break-all\">{{ .ConfirmationURL }}</a></p>{{ end }}\n</td></tr>\n<tr><td style=\"padding:24px 8px 0;font-size:12px;line-height:18px;color:#737373;text-align:center\">\n{{ if and .Data.lang (eq .Data.lang \"nl\") }}Je ontvangt deze e-mail omdat iemand dit adres ({{ .Email }}) bij Bingr heeft gebruikt. Was jij dit niet? Dan kun je deze e-mail negeren.{{ else }}You received this email because this address ({{ .Email }}) was used with Bingr. If this wasn't you, you can ignore this email.{{ end }}<br><br>\n<a href=\"https://bingr.online\" style=\"color:#b3b3b3;text-decoration:none;font-weight:700\">bingr.online</a> &nbsp;·&nbsp; <a href=\"https://support.bingr.online/\" style=\"color:#737373\">Support</a> &nbsp;·&nbsp; <a href=\"https://bingr.online/privacy.html\" style=\"color:#737373\">Privacy</a>\n</td></tr>\n</table></td></tr></table></body></html>",
 "mailer_subjects_email_change": "Bingr · Bevestig je nieuwe e-mailadres / Confirm your new email",
 "mailer_templates_email_change_content": "<!doctype html>\n<html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><meta name=\"supported-color-schemes\" content=\"dark\"><title>Bingr</title></head>\n<body style=\"margin:0;padding:0;background:#000000\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#000000\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:520px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\">\n<tr><td style=\"padding:0 4px 24px\">\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n    <td style=\"vertical-align:middle\"><img src=\"https://bingr.online/apple-touch-icon.png\" width=\"44\" height=\"44\" alt=\"\" style=\"display:block;border-radius:10px\"></td>\n    <td style=\"vertical-align:middle;padding-left:12px\"><div style=\"font-size:30px;font-weight:900;letter-spacing:1px;color:#ffffff;line-height:30px\">BINGR</div><div style=\"height:4px;width:74px;background:#E50914;border-radius:2px;margin-top:6px\"></div></td>\n  </tr></table>\n</td></tr>\n<tr><td style=\"background:#141414;border-radius:12px;padding:36px 32px;border-top:4px solid #E50914\">\n{{ if and .Data.lang (eq .Data.lang \"nl\") }}<h1 style=\"margin:0 0 16px;font-size:26px;line-height:32px;font-weight:800;color:#ffffff\">Bevestig je nieuwe e-mailadres</h1><p style=\"margin:0 0 28px;font-size:16px;line-height:24px;color:#d6d6d6\">Je wilt het e-mailadres van je Bingr-account wijzigen naar {{ .NewEmail }}. Bevestig dit met de knop hieronder.</p><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#E50914;color:#ffffff;text-decoration:none;font-weight:700;font-size:16px;padding:14px 32px;border-radius:6px\">Nieuw adres bevestigen</a><p style=\"margin:28px 0 0;font-size:14px;line-height:21px;color:#b3b3b3\">Heb je dit niet aangevraagd? Wijzig dan meteen je wachtwoord.</p><p style=\"margin:28px 0 0;font-size:12px;line-height:18px;color:#8c8c8c\">Werkt de knop niet? Kopieer deze link:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#b3b3b3;word-break:break-all\">{{ .ConfirmationURL }}</a></p>{{ else }}<h1 style=\"margin:0 0 16px;font-size:26px;line-height:32px;font-weight:800;color:#ffffff\">Confirm your new email address</h1><p style=\"margin:0 0 28px;font-size:16px;line-height:24px;color:#d6d6d6\">You asked to change the email address of your Bingr account to {{ .NewEmail }}. Confirm with the button below.</p><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#E50914;color:#ffffff;text-decoration:none;font-weight:700;font-size:16px;padding:14px 32px;border-radius:6px\">Confirm new address</a><p style=\"margin:28px 0 0;font-size:14px;line-height:21px;color:#b3b3b3\">Didn't ask for this? Change your password right away.</p><p style=\"margin:28px 0 0;font-size:12px;line-height:18px;color:#8c8c8c\">Button not working? Copy this link:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#b3b3b3;word-break:break-all\">{{ .ConfirmationURL }}</a></p>{{ end }}\n</td></tr>\n<tr><td style=\"padding:24px 8px 0;font-size:12px;line-height:18px;color:#737373;text-align:center\">\n{{ if and .Data.lang (eq .Data.lang \"nl\") }}Je ontvangt deze e-mail omdat iemand dit adres ({{ .Email }}) bij Bingr heeft gebruikt. Was jij dit niet? Dan kun je deze e-mail negeren.{{ else }}You received this email because this address ({{ .Email }}) was used with Bingr. If this wasn't you, you can ignore this email.{{ end }}<br><br>\n<a href=\"https://bingr.online\" style=\"color:#b3b3b3;text-decoration:none;font-weight:700\">bingr.online</a> &nbsp;·&nbsp; <a href=\"https://support.bingr.online/\" style=\"color:#737373\">Support</a> &nbsp;·&nbsp; <a href=\"https://bingr.online/privacy.html\" style=\"color:#737373\">Privacy</a>\n</td></tr>\n</table></td></tr></table></body></html>",
 "mailer_subjects_reauthentication": "Bingr · Je verificatiecode / Your verification code",
 "mailer_templates_reauthentication_content": "<!doctype html>\n<html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><meta name=\"supported-color-schemes\" content=\"dark\"><title>Bingr</title></head>\n<body style=\"margin:0;padding:0;background:#000000\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#000000\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:520px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\">\n<tr><td style=\"padding:0 4px 24px\">\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n    <td style=\"vertical-align:middle\"><img src=\"https://bingr.online/apple-touch-icon.png\" width=\"44\" height=\"44\" alt=\"\" style=\"display:block;border-radius:10px\"></td>\n    <td style=\"vertical-align:middle;padding-left:12px\"><div style=\"font-size:30px;font-weight:900;letter-spacing:1px;color:#ffffff;line-height:30px\">BINGR</div><div style=\"height:4px;width:74px;background:#E50914;border-radius:2px;margin-top:6px\"></div></td>\n  </tr></table>\n</td></tr>\n<tr><td style=\"background:#141414;border-radius:12px;padding:36px 32px;border-top:4px solid #E50914\">\n{{ if and .Data.lang (eq .Data.lang \"nl\") }}<h1 style=\"margin:0 0 16px;font-size:26px;line-height:32px;font-weight:800;color:#ffffff\">Je verificatiecode</h1><p style=\"margin:0 0 28px;font-size:16px;line-height:24px;color:#d6d6d6\">Gebruik deze code om te bevestigen dat jij het bent:</p><div style=\"font-size:34px;font-weight:800;letter-spacing:8px;color:#fff;background:#1f1f1f;border-radius:8px;padding:18px 0;text-align:center\">{{ .Token }}</div><p style=\"margin:28px 0 0;font-size:14px;line-height:21px;color:#b3b3b3\">De code is kort geldig. Deel hem met niemand.</p>{{ else }}<h1 style=\"margin:0 0 16px;font-size:26px;line-height:32px;font-weight:800;color:#ffffff\">Your verification code</h1><p style=\"margin:0 0 28px;font-size:16px;line-height:24px;color:#d6d6d6\">Use this code to confirm it's you:</p><div style=\"font-size:34px;font-weight:800;letter-spacing:8px;color:#fff;background:#1f1f1f;border-radius:8px;padding:18px 0;text-align:center\">{{ .Token }}</div><p style=\"margin:28px 0 0;font-size:14px;line-height:21px;color:#b3b3b3\">This code expires soon. Don't share it with anyone.</p>{{ end }}\n</td></tr>\n<tr><td style=\"padding:24px 8px 0;font-size:12px;line-height:18px;color:#737373;text-align:center\">\n{{ if and .Data.lang (eq .Data.lang \"nl\") }}Je ontvangt deze e-mail omdat iemand dit adres ({{ .Email }}) bij Bingr heeft gebruikt. Was jij dit niet? Dan kun je deze e-mail negeren.{{ else }}You received this email because this address ({{ .Email }}) was used with Bingr. If this wasn't you, you can ignore this email.{{ end }}<br><br>\n<a href=\"https://bingr.online\" style=\"color:#b3b3b3;text-decoration:none;font-weight:700\">bingr.online</a> &nbsp;·&nbsp; <a href=\"https://support.bingr.online/\" style=\"color:#737373\">Support</a> &nbsp;·&nbsp; <a href=\"https://bingr.online/privacy.html\" style=\"color:#737373\">Privacy</a>\n</td></tr>\n</table></td></tr></table></body></html>"
}